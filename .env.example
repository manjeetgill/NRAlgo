# Localhost works without this file. Never commit a real .env file.
APP_ENV=development
# Default is false even when omitted. Do not enable for broker-connected paper testing.
ENABLE_LIVE_TRADING=false
APP_ORIGIN=http://localhost:3000
# Optional locally; required for first-time production setup.
SETUP_TOKEN=
# Accounts are open locally, invite-only/closed in production unless explicitly enabled.
# REGISTRATION_TOKEN=generate-at-least-32-random-characters-to-invite-users
# ALLOW_PUBLIC_REGISTRATION=false
# Local credentials use an automatically generated .runtime/broker.key.
# Production requires this persistent key; back it up separately from the database.
# BROKER_ENCRYPTION_KEY=64-random-hex-characters
# Local default: project-owned PostgreSQL on 127.0.0.1:55432, started by make run.
# Generated credentials are private in .runtime/postgres-access.json; do not commit them.
# To use an existing PostgreSQL server instead, supply runtime and migration connections:
# DATABASE_URL=postgresql://runtime-user:password@localhost:5432/nralgo
# MIGRATION_DATABASE_URL=postgresql://migration-user:password@localhost:5432/nralgo
# TEST_DATABASE_URL=postgresql://test-admin:password@localhost:5432/test_database

# Docker production configuration:
# Compose sets production mode and HTTPS origin automatically.
# APP_DOMAIN=algo.example.com
# SETUP_TOKEN=generate-a-random-token-of-at-least-32-characters
# POSTGRES_PASSWORD=generate-a-strong-alphanumeric-password
# APP_DATABASE_PASSWORD=64-random-hex-characters-for-the-restricted-runtime-role
# BACKUP_ENCRYPTION_KEY=a-different-64-character-random-hex-key
# BACKUP_S3_URI=s3://your-private-backup-bucket/nralgo
# AWS_REGION=ap-south-1
# Prefer a restricted instance role where available; otherwise restricted backup-only credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
