# Localhost works without this file. Never commit a real .env file.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Optional locally; required for first-time production setup.
SETUP_TOKEN=
# Local default: SQLite in .runtime/workspace.db
# DATABASE_URL=postgresql://nexus:password@localhost:5432/nexus

# Docker production configuration:
# Compose sets production mode and HTTPS origin automatically.
# APP_DOMAIN=algo.example.com
# SETUP_TOKEN=generate-a-random-token-of-at-least-32-characters
# POSTGRES_PASSWORD=generate-a-strong-alphanumeric-password
