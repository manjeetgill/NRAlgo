# Localhost works without this file. Never commit a real .env file.
APP_ENV=development
# NODE_ENV=production also enforces production security, even with APP_ENV=development.
# Live execution stays OFF unless explicitly enabled by the server operator.
LIVE_TRADING_ENABLED=false
# Set true only after registering this server's static outbound IP with Kotak.
KOTAK_STATIC_IP_CONFIRMED=false
APP_ORIGIN=http://localhost:3000
# Optional locally; required for first-time production setup.
SETUP_TOKEN=
# Accounts are open locally, invite-only/closed in production unless explicitly enabled.
# REGISTRATION_TOKEN=generate-at-least-32-random-characters-to-invite-users
# ALLOW_PUBLIC_REGISTRATION=false
# Local credentials use an automatically generated .runtime/broker.key.
# Production requires this persistent key; back it up separately from the database.
# BROKER_ENCRYPTION_KEY=64-random-hex-characters
# Local default: project-owned PostgreSQL on 127.0.0.1:55432, started by make run.
# Generated credentials are encrypted in .runtime/postgres-access.json; never commit it or its key.
# To use an existing PostgreSQL server instead, supply runtime and migration connections:
# DATABASE_URL=postgresql://runtime-user:password@localhost:5432/nralgo
# MIGRATION_DATABASE_URL=postgresql://migration-user:password@localhost:5432/nralgo
# Private Node-to-Python authentication; use a different 32+ character value in production.
# CALCULATION_SERVICE_TOKEN=generate-a-separate-random-token-of-at-least-32-characters
# CALCULATION_SERVICE_URL=http://127.0.0.1:8010

# Docker production .env stores NONSECRET settings only. Remove local SETUP_TOKEN and
# broker secret values above/below; populate mounted files with host-operations export-secrets.
# Compose grants each service only its own files. Keep the directory mode 0700.
# APP_DOMAIN=your-real-domain
# SECRETS_DIR=/etc/nraialgo/secrets-v1
# ALLOW_PUBLIC_REGISTRATION=false
# Copy CI's release.env artifact to .env.release; all six IMAGE references must include digests.
# BACKUP_S3_URI=s3://your-private-space/nralgo
# BACKUP_S3_ENDPOINT=https://blr1.digitaloceanspaces.com
# BACKUP_S3_REGION=blr1
# Bounded pg_dump/restore deadline: 60–21600 seconds; default 30 minutes.
# BACKUP_DATABASE_TIMEOUT_SECONDS=1800
# Put scoped SPACES_ACCESS_KEY_ID and SPACES_SECRET_ACCESS_KEY values only in mounted files.
# ALERT_WEBHOOK_URL=https://your-private-monitoring-webhook
# DEPLOYMENT_NAME=nraialgo-terminal
# Market data is selected independently of the broker account. Kotak is currently bundled.
MARKET_DATA_PROVIDER=kotak
# Optional Zerodha connection. Register APP_ORIGIN/brokers/zerodha/callback in Kite.
# Never prefix these with NEXT_PUBLIC_ or put secrets in frontend code.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
