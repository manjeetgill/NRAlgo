# Keep dependencies, generated builds, local databases, keys and backups out of version control.
node_modules/
dist/
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
.DS_Store
.runtime/
frontend/.next/
frontend/.next-*/
frontend/out/
*.tsbuildinfo
.eslintcache
backups/

# Generated test evidence is separate from application runtime data.
tests/artifacts/
__pycache__/

# Credentials and private exports must never enter Git, even outside .runtime.
*.key
*.pem
*.p12
*.pfx
*.dump
*.backup
*.sqlite
*.sqlite3
*.log
secrets/
postgres-access.json
