{
  "name": "nralgo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:spec": "node scripts/check-specification-acceptance.mjs",
    "check:acceptance": "node scripts/check-specification-acceptance.mjs --strict",
    "test:browser": "node tests/e2e/kotak-smoke.mjs",
    "format": "prettier --write 'backend/**/*.ts' run.ts 'tests/**/*.{ts,mjs}' 'frontend/src/**/*.{ts,tsx,css}' frontend/next.config.ts frontend/postcss.config.mjs",
    "lint": "eslint . --concurrency=off --cache --quiet",
    "lint:all": "eslint . --concurrency=off --cache",
    "dev": "npm run build:backend && node --env-file-if-exists=.env --import tsx run.ts",
    "start": "node --env-file-if-exists=.env dist/backend/main.js",
    "worker": "node --env-file-if-exists=.env dist/backend/worker.js",
    "migrate": "node --env-file-if-exists=.env --import tsx backend/database.ts",
    "test": "npm run build:backend && node --test tests/backend/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:backend": "tsc",
    "check": "npm run lint && npm test && npm --prefix frontend run typecheck && npm --prefix frontend test && npm run test:architecture",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "build": "npm run build:backend && npm --prefix frontend run build"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "express": "^5.1.0",
    "otpauth": "9.5.2",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "2.13.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "8.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "14.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.7",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.67.0"
  }
}
