{
  "name": "nralgo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.mjs",
    "check:production": "node --env-file=.env --env-file=.env.release scripts/check-production-environment.mjs",
    "preflight:commit": "node scripts/preflight-commit.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "prettier --write 'backend/**/*.ts' run.ts 'frontend/src/**/*.{ts,tsx,css}' frontend/next.config.ts frontend/postcss.config.mjs",
    "lint": "eslint . --concurrency=off --cache --quiet",
    "lint:all": "eslint . --concurrency=off --cache",
    "dev": "npm run build:backend && node --env-file-if-exists=.env --import tsx run.ts",
    "start": "node --env-file-if-exists=.env dist/backend/main.js",
    "migrate": "node --env-file-if-exists=.env --import tsx backend/database.ts",
    "historical:archive": "node --env-file-if-exists=.env --import tsx scripts/migrate-eod-to-parquet.mjs",
    "historical:verify": "node --env-file-if-exists=.env --import tsx scripts/migrate-eod-to-parquet.mjs --verify",
    "historical:verify-archive": "node --env-file-if-exists=.env --import tsx scripts/migrate-eod-to-parquet.mjs --archive-only",
    "historical:retire-postgres": "node --env-file-if-exists=.env --import tsx scripts/retire-postgres-eod-candles.mjs --confirm-retire-eod-candles",
    "typecheck": "tsc --noEmit",
    "build:backend": "tsc",
    "check": "npm run lint && npm run typecheck && npm --prefix frontend run typecheck && npm test",
    "build": "npm run build:backend && npm --prefix frontend run build"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "csv-parse": "7.0.2",
    "express": "^5.1.0",
    "kiteconnect": "5.3.0",
    "otpauth": "9.5.2",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "kiteconnect": {
      "mocha": {
        "serialize-javascript": "7.0.5"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "2.13.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "8.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "14.0.0",
    "prettier": "3.9.7",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.67.0"
  }
}
