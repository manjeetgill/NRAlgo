{
  "name": "nralgo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx run.ts",
    "start": "node --env-file-if-exists=.env dist/backend/main.js",
    "worker": "node --env-file-if-exists=.env dist/backend/worker.js",
    "migrate": "node --env-file-if-exists=.env --import tsx backend/database.ts",
    "test": "npm run build:backend && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:backend": "tsc",
    "check": "npm test && npm --prefix frontend run typecheck",
    "build": "npm run build:backend && npm --prefix frontend run build"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "breezeconnect": "1.0.31",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "breezeconnect": {
      "axios": "0.33.0",
      "csv-parse": "7.0.2"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
