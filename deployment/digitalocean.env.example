# Copy to /opt/nraialgo/.env on the Droplet and keep mode 0600.
# This file contains non-secret production settings only.
APP_DOMAIN=
SECRETS_DIR=/etc/nraialgo/secrets-v1

# Keep execution disabled until the Reserved IPv4 is confirmed as the outbound
# address and that address is registered with Kotak.
LIVE_TRADING_ENABLED=false
KOTAK_STATIC_IP_CONFIRMED=false
ALLOW_PUBLIC_REGISTRATION=false
MARKET_DATA_PROVIDER=kotak

# DigitalOcean Spaces in Bangalore. BACKUP_S3_URI uses the S3-compatible URI.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=https://blr1.digitaloceanspaces.com
BACKUP_S3_REGION=blr1
BACKUP_DATABASE_TIMEOUT_SECONDS=1800

# Private HTTPS receiver for operational alerts; this is not the TradingView URL.
ALERT_WEBHOOK_URL=
DEPLOYMENT_NAME=nraialgo-terminal

# Optional host directory containing verified Parquet history archives.
HISTORICAL_ARCHIVE_DIRECTORY=./.runtime/historical-parquet
