# Build from lockfiles, not local dependencies; never send credentials/databases to Docker context.
node_modules
dist
.env
.env.*
.git
.runtime
tests
frontend/node_modules
frontend/.next
frontend/out
*.tsbuildinfo
**/.env*
backups
.github
README.md
LICENSE
Makefile
**/.DS_Store

docs

# Keep development documentation and tests in Git, not in deployment builds.
**/README*
**/readme*
**/tests
**/__tests__
**/*.test.*
**/*.spec.*
.vscode
